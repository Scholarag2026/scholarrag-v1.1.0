# =============================================================================
# ScholarRAG - Environment Variables
# Copy this file to .env at the repository root and fill in the values:
#   cp .env.example .env
# Names map one to one to backend/app/config.py (pydantic-settings).
# =============================================================================

# --- Application ---------------------------------------------------------
# Keep "development" for local use. Outside development/test/local, the boot
# guard in backend/app/config.py refuses to start when JWT_SECRET_KEY is empty,
# still the literal placeholder below, or shorter than 32 characters.
APP_ENV=development

# --- PostgreSQL ------------------------------------------------------------
# POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB are the exception to the
# one-to-one mapping above: they are not fields of Settings. Docker Compose
# reads them to create the database and to build its own DATABASE_URL.
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=secret
POSTGRES_DB=deepresearch
# From the host (backend run outside Docker) use localhost.
# Both compose files override this variable in their own environment block,
# so this value only applies when you run the backend without Docker.
DATABASE_URL=postgresql+asyncpg://deepresearch:secret@localhost:5432/deepresearch

# --- JWT authentication --------------------------------------------------
# This literal value is the placeholder the boot guard checks for. Replace it
# with a random secret of at least 32 characters before setting APP_ENV to
# anything other than development, test, or local.
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (DeepSeek) --------------------------------------------------------
# Paid and metered per token. See README "Requirements at a glance" for
# current list prices and the access date they were read.
# "deepseek-chat" and "deepseek-reasoner" are retired names; "deepseek-flash" is the
# provider's current name for the deployment every agent below uses, including the relevance
# screener's own second pass (SCREENER_SECOND_PASS_MODEL), which re-checks only the papers
# already marked INCLUDE, with reasoning on and SCREENER_SECOND_PASS_OUTPUT_MODE "prompted"
# (deepseek-flash rejects a forced tool_choice while reasoning is on; "prompted" avoids
# sending one). Every LLM call's own provenance record still carries the model DeepSeek
# actually served (model_reported) and its system_fingerprint, regardless of the
# configured name.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONER_MODEL=deepseek-flash
SCREENER_SECOND_PASS_MODEL=deepseek-flash
# The second pass runs once per job, after the search finishes, judging every provisional
# INCLUDE the whole job produced as one concurrent stage (five records per call):
# SCREENER_SECOND_PASS_CONCURRENCY caps how many of those calls run at once, and
# SCREENER_SECOND_PASS_STAGE_BUDGET_SECONDS caps the stage's own wall-clock time -- entirely
# separate from the search's own time budget, so the judge never shortens the search --
# before it stops launching new calls and routes whatever is left to a human instead.
SCREENER_SECOND_PASS_CONCURRENCY=8
SCREENER_SECOND_PASS_STAGE_BUDGET_SECONDS=1800
# How the second pass asks its judge model for a structured answer: "tool" (pydantic-ai's
# own tool-calling output, a forced tool_choice) or "prompted" (the shipped default: the
# answer schema goes into the prompt instead and the model answers in plain JSON text, with
# no tool_choice sent). Both produce identical decision and provenance fields. "prompted" is
# what lets SCREENER_SECOND_PASS_MODEL's own deepseek-flash judge answer with reasoning on;
# "tool" is still available for a judge model that does not reject that combination.
SCREENER_SECOND_PASS_OUTPUT_MODE=prompted
# Writer-only override: when set, the AI Write call alone uses this model instead of
# DEEPSEEK_MODEL (every other agent -- analysis, citation-link, query, screener,
# verifier -- always uses DEEPSEEK_MODEL). Leave unset to keep the default.
# WRITING_MODEL=deepseek-v4-pro
# Writer-only thinking-mode toggle: "enabled" or "disabled". Leave unset to send no
# "thinking" field at all, so the provider's own default applies. Only the AI Write
# call reads this.
# WRITING_THINKING=disabled
# Writer-only max_tokens override for the AI Write call. Defaults to 4096.
# WRITING_MAX_TOKENS=16384

# --- Scholarly data APIs (all free) -----------------------------------------
# Email for the OpenAlex "polite pool" (higher rate limits).
OPENALEX_EMAIL=you@example.org
# Optional OpenAlex account API key (openalex.org/settings/api). Without it,
# requests share the anonymous per-IP quota and may return HTTP 429.
OPENALEX_API_KEY=
# Email required by the Unpaywall API for open-access lookups.
UNPAYWALL_EMAIL=you@example.org

# --- URLs --------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- File storage (relative to the backend working directory) --------------
STORAGE_PATH=./data/uploads

# =============================================================================
# Search, analysis, graph, timeout, and connection-pool tuning all have code
# defaults in backend/app/config.py and can all be overridden by setting the
# matching upper-case name in .env; they are omitted here because the defaults
# are the tested values.
#
# The Web of Science Core Collection journal lists (SCIE, SSCI, AHCI, ESCI)
# are optional, licensed by Clarivate, and not configured through .env. They
# are files placed in backend/data/wos/; see README "Data notice".
#
# Compose-only overrides, set on the command line or in your shell, not in
# .env, because a .env value here would apply regardless of which host port
# a container is actually bound to:
#   POSTGRES_PORT, BACKEND_PORT, FRONTEND_PORT
#   PUBLIC_FRONTEND_ORIGIN, PUBLIC_BACKEND_ORIGIN, PUBLIC_API_URL
#
# Frontend (frontend/.env.local, create separately, or a Docker build arg):
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# =============================================================================
