# Environment
.env
.venv/


# Node
node_modules/

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Next.js
.next/

# Testing & Linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# evaluation artefacts (regenerated by fetch scripts)
evaluation/.venv/
evaluation/**/data/

# demo run outputs (credentials.json and multi-MB run artefacts)
demo/output/*
!demo/output/.gitignore

# Clarivate-licensed journal lists: kept on disk, never committed.
# See LICENSE.txt and README.md ("Data notice").
/*.csv
backend/data/wos/*.csv

# Local MCP server configuration; holds credentials, never commit.
/.mcp.json

# Local Claude Code settings carry personal permission allowlists; never commit.
.claude/settings.local.json
